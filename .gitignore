# ==========================================
# ForOne - AI Personalized Education Platform
# Git Ignore Configuration
# ==========================================

# ------------------------------------------
# CRITICAL: API Keys, Secrets & Credentials
# ------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
!*.env.example

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
*/venv/
*/.venv/
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------
# Node.js & Frontend Builds
# ------------------------------------------
node_modules/
*/node_modules/
dist/
*/dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ------------------------------------------
# Storage, Generated Videos & Databases
# (Keep directory structure via .gitkeep)
# ------------------------------------------
storage/database/*.db
storage/database/*.db-journal
storage/database/*.sqlite*
!storage/database/.gitkeep

storage/lectures/personalized/*
!storage/lectures/personalized/.gitkeep

storage/lectures/master/*
!storage/lectures/master/.gitkeep
!storage/lectures/master/lec_binary_search_101

# Temp ffmpeg frame directories
**/temp_frames/

# ------------------------------------------
# OS & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
